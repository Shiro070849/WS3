# Backend API Base URL (ใช้สำหรับ API calls และ static files)
# ไฟล์นี้ใช้สำหรับ Production Build (npm run build)

# Development (ใช้ .env.development แทน - สำหรับ npm run serve)
# VUE_APP_API_URL=http://localhost:8088

# Production - IP + Path (สำหรับ: http://192.168.31.36/smartsecruity/)
VUE_APP_API_URL=http://192.168.31.36:8088

# สำหรับ subdomain build ใช้ build-subdomain.bat แทน หรือตั้งค่า:
# VUE_APP_USE_SUBDOMAIN=true