<template>
  <div class="w-full max-w-full animate-fadeIn">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="page-title">รีปริ้น / Reprint</h1>
      <p class="text-lg text-slate-500 m-0 font-prompt font-medium">
        แก้ไขและพิมพ์ใบเข้า-ออกใหม่
      </p>
