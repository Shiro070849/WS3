            crossorigin="anonymous"
          />
          <div v-else style="font-size: 20px; font-weight: bold; margin-bottom: 4px;">{{ wayinData.IC_LocalName || 'MRG' }}</div>
          <div style="font-size: 11px; margin-bottom: 2px;">{{ wayinData.IC_LocalName || 'บริษัท มารีนโกลด์โปรดักส์ จำกัด' }}</div>
          <div style="font-size: 9px; color: #666;">{{ wayinData.IC_EnglishName || 'Marigold Products Company Limited' }}</div>
        </div>

        <!-- ข้อมูล -->
        <div style="font-size: 12px; line-height: 1.6;">
          <div style="margin-bottom: 3px;">ประเภทผู้มาติดต่อ : ผู้มาติดต่อ</div>
          <div style="margin-bottom: 3px;">ชื่อ-สกุล : {{ editForm.fullName || '-' }}</div>
          <div style="margin-bottom: 3px;">เลขบัตรประชาชน : {{ editForm.cardId || '-' }}</div>
          <div style="margin-bottom: 3px;">เลขทะเบียนรถ : {{ editForm.licensePlate || '-' }}</div>
          <div style="margin-bottom: 3px;">ทะเบียนจังหวัด : {{ editForm.licenseProvince || '-' }}</div>
          <div style="margin-bottom: 3px;">รายละเอียด : {{ editForm.address || '-' }}</div>
          <div style="margin-bottom: 3px;">จำนวนผู้มาติดต่อ : {{ editForm.follower || 0 }}</div>
          <div style="margin-bottom: 3px;">ยานพาหนะ : {{ editForm.vehicleType || '-' }}</div>
          <div style="margin-bottom: 3px;">ผู้รับการติดต่อ/แผนก : {{ editForm.internalDivision || '-' }}</div>
          <div style="margin-bottom: 3px;">เวลาเข้า : {{ formatDate(wayinData.WI_RecordedOn) }}</div>
          <div style="margin-bottom: 3px;">เวลาออก : {{ (wayinData.CheckOutTime && wayinData.CheckOutTime !== '0001-01-01T00:00:00.000Z') ? formatDate(wayinData.CheckOutTime) : '-' }}</div>
          <div style="margin-bottom: 3px;">หมายเหตุ : {{ editForm.remarks || '-' }}</div>
          <div style="margin-bottom: 8px;">สถานที่ปริ้น : {{ getLocationName() }}</div>
        </div>

        <!-- QR Code placeholder -->
        <div style="text-align: center; margin: 12px 0;">
          <div style="font-size: 9px; color: #999;">[QR Code]</div>
        </div>

        <!-- Barcode -->
        <div style="text-align: center; margin: 10px 0;">
          <div style="font-size: 16px; letter-spacing: 2px; font-family: 'Courier New', monospace; font-weight: bold;">
            {{ wayinData.WI_Barcode }}
          </div>
        </div>

        <!-- Footer -->
        <div style="text-align: center; margin-top: 15px; font-size: 11px; line-height: 1.6;">
          <div>กรุณา Check In กับเจ้าหน้าที่ที่มาติดต่อก่อนออกบริษัท</div>
          <div>*** ห้ามทำใบสลิปหาย ***</div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, computed } from 'vue';
import { wayinAPI } from '../services/api';

// States
const searchQuery = ref('');
const loading = ref(false);
const saving = ref(false);
const errorMessage = ref('');
const wayinData = ref(null);
const allData = ref([]);

// Edit Form
const editForm = ref({
  fullName: '',
  cardId: '',
  address: '',
  licensePlate: '',
  licenseProvince: '',
  vehicleType: '',
  internalDivision: '',
  follower: 0,
  remarks: ''
});

// Filtered Data
const filteredData = computed(() => {
  if (!searchQuery.value.trim()) {
    return allData.value;
  }

  const query = searchQuery.value.toLowerCase();
  return allData.value.filter(item =>
    item.WI_Barcode?.toLowerCase().includes(query)
  );
});

// ดึงข้อมูลทั้งหมด
const fetchAllData = async () => {
  loading.value = true;
  errorMessage.value = '';

  try {
    const response = await wayinAPI.getAll({ limit: 1000 });

    if (response.data.success) {
      allData.value = response.data.data;
    }
  } catch (error) {
    console.error('Fetch error:', error);
    errorMessage.value = 'เกิดข้อผิดพลาดในการโหลดข้อมูล';
  } finally {
    loading.value = false;
  }
};

// Filter data
const filterData = () => {
  // Computed property จะทำงานอัตโนมัติ
};

// เลือกรายการ
const selectItem = (item) => {
  wayinData.value = item;

  // Populate edit form
  editForm.value = {
    fullName: item.WI_FullName || '',
    cardId: item.WI_CardID || '',
    address: item.WI_Address || '',
    licensePlate: item.WI_LicensePlate || '',
    licenseProvince: item.WI_LicenseProvince || '',
    vehicleType: item.WI_VehicleType || '',
    internalDivision: item.WI_InternalDivision || '',
    follower: item.WI_Follower || 0,
    remarks: item.WI_Remarks || ''
  };
};

// บันทึกการแก้ไข
const saveChanges = async () => {
  if (!wayinData.value) return;

  saving.value = true;
  errorMessage.value = '';

  try {
    const response = await wayinAPI.update(wayinData.value.WI_ID, editForm.value);

    if (response.data.success) {
      alert('✅ บันทึกการแก้ไขเรียบร้อยแล้ว');
      wayinData.value = response.data.data;
    }
  } catch (error) {
    console.error('Save error:', error);
    alert('❌ เกิดข้อผิดพลาดในการบันทึก: ' + (error.response?.data?.message || error.message));
  } finally {
    saving.value = false;
  }
};

// พิมพ์ใบ (Browser Print)
const printReceipt = () => {
  const printContent = document.getElementById('printTemplate').innerHTML;
  const printWindow = window.open('', '', 'width=800,height=600');

  printWindow.document.write(`
    <html>
      <head>
        <title>พิมพ์ใบเข้า-ออก</title>
        <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <style>
          * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
          }
          body {
            margin: 0;
            padding: 0;
            font-family: 'Prompt', sans-serif;
          }
          @page {
            size: 80mm auto;
            margin: 0;
          }
          @media print {
            body {
              margin: 0;
              width: 80mm;
            }
          }
        </style>
      </head>
      <body>
        ${printContent}
      </body>
    </html>
  `);

  printWindow.document.close();

  // รอให้รูปภาพโหลดเสร็จก่อนพิมพ์
  printWindow.onload = () => {
    setTimeout(() => {
      printWindow.focus();
      printWindow.print();
      printWindow.close();
    }, 500);
  };
};

// ปิด Modal
const closeModal = () => {
  wayinData.value = null;
  errorMessage.value = '';
  editForm.value = {
    fullName: '',
    cardId: '',
    address: '',
    licensePlate: '',
    licenseProvince: '',
    vehicleType: '',
    internalDivision: '',
    follower: 0,
    remarks: ''
  };
};

// Format Date - แสดงเวลาตรงตาม database โดยไม่แปลง timezone
const formatDate = (dateString) => {
  if (!dateString) return '-';

  // Parse string datetime โดยตรง ไม่ผ่าน Date object เพื่อหลีกเลี่ยง timezone conversion
  let dateStr = String(dateString);

  // ลบ Z ออกถ้ามี (SQL Server ส่ง local time แต่อาจมี Z ท้าย)
  dateStr = dateStr.replace('Z', '');

  // Parse แบบ manual จาก format: 2025-11-07T14:10:26.980
  const parts = dateStr.split(/[T\s\-:.]/);

  if (parts.length >= 5) {
    const year = parts[0];
    const month = String(parts[1]).padStart(2, '0');
    const day = String(parts[2]).padStart(2, '0');
    const hours = String(parts[3]).padStart(2, '0');
    const minutes = String(parts[4]).padStart(2, '0');

    return `${day}/${month}/${year} ${hours}:${minutes}`;
  }

  // fallback
  return dateStr;
};

// Get Location Name (สถานที่ปริ้น)
const getLocationName = () => {
  const username = localStorage.getItem('username') || 'ไม่ระบุ';
  return `ประตู${username}`;
};

// Get Logo URL
const getLogoUrl = (logoPath) => {
  if (!logoPath) return '';
  // ถ้า logoPath เป็น path เต็ม (เช่น /uploads/logos/1_Logo_xxx.png)
  if (logoPath.startsWith('http')) {
    return logoPath;
  }
  // สร้าง URL จาก backend
  return `http://localhost:8088${logoPath}`;
};

// Load data on mount
onMounted(() => {
  fetchAllData();
});
</script>

<style scoped>
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.5s ease-in;
}
</style>
