        <!-- ทะเบียนจังหวัด -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">ทะเบียนจังหวัด</label>
          <input
            v-model="editForm.licenseProvince"
            type="text"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-prompt"
          />
        </div>

        <!-- รายละเอียด -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">รายละเอียด</label>
          <textarea
