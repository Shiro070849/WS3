            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-prompt"
          />
        </div>

        <!-- ผู้รับการติดต่อ/แผนก -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">ผู้รับการติดต่อ/แผนก</label>
          <input
            v-model="editForm.internalDivision"
            type="text"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-prompt"
          />
        </div>

        <!-- เวลาเข้า (Read-only) -->
        <div>
          <label class="block text-sm font-semibold text-gray-500 mb-2 font-prompt">เวลาเข้า</label>
          <input
            :value="formatDate(wayinData.WI_RecordedOn)"
