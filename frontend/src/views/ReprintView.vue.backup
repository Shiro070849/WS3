            class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-500 font-prompt"
          />
        </div>

        <!-- เวลาออก (Read-only) -->
        <div>
          <label class="block text-sm font-semibold text-gray-500 mb-2 font-prompt">เวลาออก</label>
          <input
            :value="'-'"
            type="text"
            disabled
            class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-500 font-prompt"
          />
        </div>

        <!-- หมายเหตุ -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">หมายเหตุ</label>
          <textarea
            v-model="editForm.remarks"
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-prompt"
          ></textarea>
        </div>

        <!-- Buttons -->
        <div class="flex justify-end gap-4 mt-6">
          <button
            type="button"
            @click="closeModal"
            class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold font-prompt hover:bg-gray-300 transition-all"
          >
            ยกเลิก
          </button>
          <button
            type="submit"
            :disabled="saving"
            class="px-6 py-3 bg-gradient-to-r from-green-600 to-green-700 text-white rounded-lg font-semibold font-prompt hover:from-green-700 hover:to-green-800 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {{ saving ? 'กำลังบันทึก...' : 'บันทึกการแก้ไข' }}
          </button>
          <button
            type="button"
            @click="printReceipt"
            class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg font-semibold font-prompt hover:from-blue-700 hover:to-blue-800 transition-all"
          >
            พิมพ์ใบ
          </button>
        </div>
          </div>
