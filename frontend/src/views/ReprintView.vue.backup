    <!-- Print Template (ซ่อนไว้) -->
    <div v-if="wayinData" id="printTemplate" style="display: none;">
      <div style="width: 80mm; max-width: 80mm; font-family: 'Prompt', sans-serif; padding: 8px; font-size: 13px; margin: 0 auto;">
        <!-- Logo -->
        <div style="text-align: center; margin-bottom: 12px;">
          <img
            v-if="wayinData.IC_LogoPath"
            :src="getLogoUrl(wayinData.IC_LogoPath)"
            alt="Company Logo"
