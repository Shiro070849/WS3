              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-prompt">{{ item.WI_FullName || '-' }}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-prompt">{{ item.WI_LicensePlate || '-' }}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-prompt">{{ item.WI_LicenseProvince || '-' }}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-prompt">{{ formatDate(item.WI_RecordedOn) }}</td>
