          <div class="space-y-4">
        <!-- ประเภทผู้มาติดต่อ (Read-only) -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">ประเภทผู้มาติดต่อ</label>
          <input
