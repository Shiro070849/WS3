            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-prompt"
          ></textarea>
        </div>

        <!-- จำนวนผู้มาติดต่อ -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2 font-prompt">จำนวนผู้มาติดต่อ</label>
          <input
            v-model.number="editForm.follower"
